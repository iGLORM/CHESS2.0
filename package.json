{
  "name": "chess-2.0",
  "version": "1.0.0",
  "description": "Chess 2.0 \u2014 A Pixel Chess Adventure",
  "author": "iGLORM",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test \"tests/*.test.js\"",
    "build": "electron-builder",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux",
    "build:steam:win": "electron-builder --win dir --x64",
    "build:steam:mac": "electron-builder --mac dir",
    "build:steam:linux": "electron-builder --linux dir"
  },
  "build": {
    "appId": "com.iglorm.chess2",
    "productName": "Chess 2.0",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "assets/**/*",
      "!assets/screenshots/**",
      "icon.png",
      "icon.ico",
      "icon_512.png",
      "icon_1024.png"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "mac": {
      "target": "dmg",
      "icon": "icon_1024.png",
      "category": "public.app-category.board-games"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "icon_512.png",
      "category": "Game",
      "desktop": {
        "Name": "Chess 2.0",
        "Comment": "A Pixel Chess Adventure with PixiJS",
        "Categories": "Game;BoardGame;",
        "StartupNotify": "true"
      }
    },
    "copyright": "Copyright \u00a9 2026 iGLORM"
  },
  "devDependencies": {
    "@chenglou/pretext": "0.0.6",
    "electron": "44.4.5",
    "electron-builder": "25.1.8",
    "stockfish": "18.0.7"
  }
}
